# ProductFlow production-style self-hosted example.
# Copy to .env and replace every placeholder before exposing the app.

# Auth (env-only; never commit real values)
ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key
SETTINGS_ACCESS_TOKEN=replace-with-a-separate-settings-token
SESSION_SECRET=replace-with-another-long-random-session-secret

# App
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=29280
WEB_PORT=29281
APP_HOST_PORT=29280
BACKEND_CORS_ORIGINS=http://localhost:29281,http://127.0.0.1:29281
# 公网 HTTPS 部署改为 true；留空则 production 环境自动开启、开发环境自动关闭
SESSION_COOKIE_SECURE=false

# Persistence (env-only)
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://productflow:replace-with-a-random-postgres-password@productflow-postgres:5432/productflow
REDIS_HOST_PORT=16379
REDIS_URL=redis://productflow-redis:6379/0

# Container runtime storage root stays fixed at /app/storage. For production reuse/migration from the
# old systemd release, bind-mount the existing host directory by setting STORAGE_HOST_PATH, for example:
# STORAGE_HOST_PATH=/home/cot/ProductFlow-release/shared/storage
# Leave STORAGE_HOST_PATH unset to use the default Docker named volume productflow-storage.
STORAGE_ROOT=/app/storage
# STORAGE_HOST_PATH=

# Provider settings are configured in the web settings page after startup.
# These legacy TEXT_* / IMAGE_* values are still passed to the containers so the first startup after upgrade can
# create provider_profiles/provider_bindings from existing .env values. After migration, edit providers in /settings.
TEXT_PROVIDER_KIND=mock
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_BRIEF_MODEL=gpt-4o
TEXT_COPY_MODEL=gpt-4o
IMAGE_PROVIDER_KIND=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_GENERATE_MODEL=gpt-image-2
# Docker compose 默认注入 true（走后台生成更稳）；本地开发默认 false
IMAGE_RESPONSES_BACKGROUND_ENABLED=false
IMAGE_IMAGES_QUALITY=
IMAGE_IMAGES_STYLE=
IMAGE_MAIN_IMAGE_SIZE=1024x1024
IMAGE_PROMO_POSTER_SIZE=1024x1536

# Poster generation: template does not call the image provider; generated does.
POSTER_GENERATION_MODE=template

# Poster rendering
POSTER_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc

# Upload safety
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_REFERENCE_IMAGES=6
UPLOAD_MAX_PIXELS=16000000
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp

# Jobs
GENERATION_MAX_CONCURRENT_TASKS=3
WORKFLOW_IMAGE_GENERATION_PROVIDER_TIMEOUT_SECONDS=900

# ── 生图供应商（中转 API；界面上配置的 image 绑定优先）──
# IMAGE_PROVIDER_KIND=openai_images
# IMAGE_BASE_URL=https://你的中转域名/v1
# IMAGE_API_KEY=你的中转key
# IMAGE_GENERATE_MODEL=gpt-image-2

# ── 设计师 Agent 供应商（中转 API 直接填这里；界面上配置的 agent 绑定优先）──
# AGENT_PROVIDER_KIND=openai
# AGENT_BASE_URL=https://你的中转域名/v1
# AGENT_API_KEY=你的中转key
# AGENT_MODEL=grok-4.6
# AGENT_FALLBACK_BASE_URL=https://你的中转域名/v1
# AGENT_FALLBACK_API_KEY=你的中转key
# AGENT_FALLBACK_MODEL=gemini-3.8-flash

# >>> 生成区：由 backend/scripts/gen_env_reference.py 生成，请勿手改 <<<
#
# 下面是 Settings 的全部环境变量（自动生成，共 71 项）。
# 未在此显式设置的变量使用括号里标注的默认值。
#
# ── 设计师 Agent 供应商（.env 直填时优先生效，中转 API 场景填这里） ──
AGENT_PROVIDER_KIND=mock
# AGENT_API_KEY=                     # （默认空）；在此填写你的值
AGENT_BASE_URL=
AGENT_MODEL=grok-4.6
# AGENT_FALLBACK_API_KEY=                     # （默认空）；在此填写你的值
AGENT_FALLBACK_BASE_URL=
AGENT_FALLBACK_MODEL=gemini-3.8-flash
AGENT_LLM_TRANSIENT_RETRIES=3
AGENT_LLM_RETRY_BASE_DELAY_SECONDS=1.0
AGENT_LLM_TOTAL_BUDGET_SECONDS=240.0

# ── 生图工具参数（images 接口的 quality/size/背景等） ──
IMAGE_TOOL_MODEL=
IMAGE_TOOL_QUALITY=
IMAGE_TOOL_OUTPUT_FORMAT=
IMAGE_TOOL_OUTPUT_COMPRESSION=
IMAGE_TOOL_BACKGROUND=
IMAGE_TOOL_MODERATION=
IMAGE_TOOL_ACTION=
IMAGE_TOOL_INPUT_FIDELITY=
IMAGE_TOOL_PARTIAL_IMAGES=
IMAGE_TOOL_N=
IMAGE_TOOL_ALLOWED_FIELDS=model,quality,output_format,output_compression,moderation,action,input_fidelity,partial_images

# ── 图片供应商与生成默认值 ──
IMAGE_PROVIDER_KIND=mock
# IMAGE_API_KEY=                     # （默认空）；在此填写你的值
IMAGE_BASE_URL=
IMAGE_GENERATE_MODEL=gpt-image-2
IMAGE_IMAGES_QUALITY=medium
IMAGE_IMAGES_STYLE=
IMAGE_RESPONSES_BACKGROUND_ENABLED=False
IMAGE_GENERATION_MAX_DIMENSION=3840
IMAGE_MAIN_IMAGE_SIZE=1024x1024
IMAGE_PROMO_POSTER_SIZE=1024x1536
IMAGE_SESSION_STALE_RUNNING_AFTER_MINUTES=90
IMAGE_SESSION_WORKER_FAILSAFE_TIME_LIMIT_MINUTES=60
IMAGE_GENERATION_PROVIDER_TIMEOUT_SECONDS=300

# ── 文本供应商（旧版遗留，agent 已独立走 AGENT_*） ──
TEXT_PROVIDER_KIND=mock
# TEXT_API_KEY=                     # （默认空）；在此填写你的值
TEXT_BASE_URL=
TEXT_BRIEF_MODEL=gpt-4o
TEXT_COPY_MODEL=gpt-4o

# ── 提示词模板（通常无需修改） ──
PROMPT_BRIEF_SYSTEM=You analyze ecommerce product facts from the JSON task data in the user message. Extract positioning, audience, supported selling angles, taboo phrases, and visual style guidance. Use only supplied facts; mark sparse facts conservatively.
PROMPT_COPY_SYSTEM=You generate editable ecommerce copy from the JSON task data in the user message. The structured-output schema owns the response fields. Write concise copy that fits the declared purpose, language policy, available facts, and reference-image context. Use only supplied facts.
PROMPT_POSTER_IMAGE_TEMPLATE=Create an image from the current user request and explicitly connected
upstream context.
User request:
{instruction}
Output size: {size}
Upstream context:
{context_block}
Visual reference policy:
{reference_policy}
{kind_requirements}
Generate the image directly. Do not return explanatory text.
PROMPT_POSTER_IMAGE_EDIT_TEMPLATE=Create an image from the current user request and explicitly connected
upstream context.
User request:
{instruction}
Output size: {size}
Upstream context:
{context_block}
Visual reference policy:
{reference_policy}
{kind_requirements}
Generate the image directly. Do not return explanatory text.
PROMPT_POSTER_IMAGE_REFERENCE_POLICY=Follow the role of every image in the input-image manifest. Preserve identity, packaging, logo and factual details only from user-owned primary_subject, person, product, brand and user_material inputs. For those user-owned subject inputs, use the actual product/subject in those images as the visual baseline. style_template input controls only composition rhythm, typography scale, palette, spacing, texture and light; never copy its text, logo, person, product or company identity.
PROMPT_IMAGE_CHAT_TEMPLATE=Create an image from the current user request.
Output size: {size}
{history_block}
Current user request:
{prompt}
Generate the image directly. Do not return explanatory text.

# ── 日志与轮转 ──
LOG_DIR=C:\Users\123\Desktop\agent\projects\active\moments-poster-studio\app\backend\storage\logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_RETENTION_DAYS=14

# ── 商品工作流 ──
WORKFLOW_IMAGE_GENERATION_PROVIDER_TIMEOUT_SECONDS=900

# ── 上传校验 ──
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_REFERENCE_IMAGES=6
UPLOAD_MAX_PIXELS=16000000
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp

# ── 海报渲染 ──
POSTER_GENERATION_MODE=template
POSTER_FONT_PATH=\usr\share\fonts\truetype\wqy\wqy-zenhei.ttc

# ── 会话 Cookie ──
SESSION_COOKIE_SECURE=
# SESSION_SECRET=                     # 默认 PydanticUndefined；在此填写你的值

# ── 管理员门禁 ──
# ADMIN_ACCESS_KEY=                     # 默认 PydanticUndefined；在此填写你的值
ADMIN_ACCESS_REQUIRED=True

# ── 基础设施连接串（compose 会自动注入） ──
DATABASE_URL=PydanticUndefined
REDIS_URL=PydanticUndefined

# ── 其他 ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=29280
BACKEND_CORS_ORIGINS=http://localhost:29281,http://127.0.0.1:29281
# SETTINGS_ACCESS_TOKEN=                     # （默认空）；在此填写你的值
STORAGE_ROOT=backend\storage
GENERATION_MAX_CONCURRENT_TASKS=3
DELETION_ENABLED=False

